# Required for production deployments; free 100-day trial: https://www.tldraw.dev/pricing
NEXT_PUBLIC_TLDRAW_LICENSE_KEY=
# Unsplash (either works; prefer server-only `UNSPLASH_ACCESS_KEY`)
UNSPLASH_ACCESS_KEY=
NEXT_PUBLIC_UNSPLASH_ACCESS_KEY=

NEXT_PUBLIC_PRIVY_APP_ID=
PRIVY_APP_SECRET=

MANTLE_RPC_URL=
PIGCASSO_TOKEN_ADDRESS=0xd38d6bbc92975501e6ba181262a3d3221dbbe640
PIGCASSO_PRO_THRESHOLD_RAW=100000000000000000000000
PRO_CACHE_TTL_SECONDS=600

# UploadThing v7
UPLOADTHING_TOKEN=

PRINTR_API_URL=https://api-preview.printr.money/v0
PRINTR_API_TOKEN=
NEXT_PUBLIC_PRINTR_TOKEN_URL_TEMPLATE=

PINATA_JWT=
PINATA_API_KEY=
PINATA_SECRET_API_KEY=
# Optional: custom gateway for faster previews (e.g. <your-gateway>.mypinata.cloud)
NEXT_PUBLIC_IPFS_GATEWAY=
NEXT_PUBLIC_NFT_FACTORY_ADDRESS=0x44825eE047B1DAd790949662aea6010E34788835
NEXT_PUBLIC_NFT_MARKETPLACE_URL_TEMPLATE=
NEXT_PUBLIC_NFT_MARKETPLACE_LABEL=
NEXT_PUBLIC_ENABLE_MULTI_PAGE=

GEMINI_API_KEY=
GEMINI_ASSISTANT_MODEL=gemini-3-pro-preview
GEMINI_IMAGE_MODEL=gemini-2.5-flash-image
# For vision tasks that require structured JSON output (OCR / Separate layers).
# Must support JSON-mode (some *image-preview models do not).
GEMINI_OCR_MODEL=gemini-2.0-flash
# Optional: map product tiers to specific Gemini image models
# (If unset, both tiers fall back to GEMINI_IMAGE_MODEL)
GEMINI_IMAGE_MODEL_NANO_BANANA=
GEMINI_IMAGE_MODEL_NANO_BANANA_PRO=
AI_DAILY_LIMIT_FREE_GENERATE=5
AI_DAILY_LIMIT_FREE_REMOVE_BG=5

AI_DAILY_LIMIT_PRO_GENERATE=0
AI_DAILY_LIMIT_PRO_REMOVE_BG=0

# Optional: IP-based daily caps (0 = unlimited)
AI_IP_DAILY_LIMIT_IMAGE=5
AI_IP_DAILY_LIMIT_SEPARATE_LAYERS=5

DATABASE_URL=

# Internal: B2B project onboarding (create/update hubs, assign templates)
PROJECT_HUB_ADMIN_TOKEN=

# Repository → Asset (GitHub + Printr)
# Encrypts GitHub OAuth tokens stored in Postgres. Generate a 32-byte key (base64) e.g.:
#   openssl rand -base64 32
GITHUB_OAUTH_ENCRYPTION_KEY=
# Repository → Asset publishes to an external Printr endpoint (server-to-server)
PRINTR_PUBLISH_URL=
# Optional: if your publish endpoint requires a bearer token
PRINTR_API_KEY=
